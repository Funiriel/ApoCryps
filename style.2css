body {
  margin: 0;
  font-family: 'Montserrat', sans-serif;
  background: radial-gradient(circle at top, #1b0f1f 0%, #050308 55%, #020106 100%);
  color: #dfc5be;
  overflow-x: hidden;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

main {
  padding-top: 120px;
}

.container {
  max-width: 1300px;
  margin: 0 auto;
  padding: 0 24px;
}

.section {
  position: relative;
  padding: 80px 0;
  overflow: hidden;
}

.section::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at top left, rgba(255, 107, 77, 0.08), transparent 55%),
    radial-gradient(circle at bottom right, rgba(223, 197, 190, 0.06), transparent 55%);
  pointer-events: none;
}

.section-title {
  position: relative;
  font-size: 1.9rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #ff6b4d;
  margin: 0 0 40px;
  text-align: center;
}

.section-title::after {
  content: "";
  display: block;
  width: 80px;
  height: 2px;
  margin: 14px auto 0;
  background: linear-gradient(90deg, #ff6b4d, rgba(255, 107, 77, 0));
  box-shadow: 0 0 18px rgba(255, 107, 77, 0.7);
}

p {
  line-height: 1.7;
  color: rgba(223, 197, 190, 0.9);
}

/* ═══════════════════════════════════
   НАВІГАЦІЯ
═══════════════════════════════════ */

.navbar {
  position: fixed;
  top: 0;
  width: 100%;
  height: 120px;
  background: rgba(0, 0, 0, 0.88);
  backdrop-filter: blur(12px);
  z-index: 1000;
  border-bottom: 1px solid rgba(255, 100, 80, 0.25);
}

.nav-container {
  max-width: 1350px;
  margin: 0 auto;
  padding: 0 30px;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  font-size: 2rem;
  font-weight: 900;
  position: relative;
  top: 27px;
}

.Pic {
  background: url('Mars.png') center/cover no-repeat;
  height: 110px;
  width: 140px;
}

.Apo { color: #dfc5be; }
.Cryps { color: #ff6b4d; }

.nav-menu a {
  color: #dfc5be;
  text-decoration: none;
  margin: 0 30px;
  font-weight: 700;
  text-transform: uppercase;
  font-size: 16px;
  transition: 0.4s;
  border-bottom: 2px solid transparent;
  padding-bottom: 8px;
}

.nav-menu a:hover {
  color: #ff6b4d;
  text-shadow: 0 0 20px rgba(255, 107, 77, 0.8);
  border-bottom: 2px solid #ff6b4d;
}

/* HERO */

.gradient-text {
  background: linear-gradient(90deg, #ff6b4d 0%, #ffb39a 50%, #ffe1d6 100%);
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero {
  position: relative;
  height: 100vh;
  min-height: 750px;
  margin-top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  transform: translateX(100%);
  transition: transform 1s ease-in-out;
  z-index: 1;
}

.hero-bg.active {
  transform: translateX(0%);
  z-index: 2;
}

.hero-bg.prev {
  transform: translateX(-100%);
  z-index: 1;
}

.hero-bg::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(rgba(0,0,0,0.35), rgba(0,0,0,0.65));
  z-index: 3;
}

.hero-content {
  position: relative;
  z-index: 5;
  padding: 0 30px;
  animation: fadeUp 1.4s ease forwards;
  opacity: 0;
  transform: translateY(20px);
}

@keyframes fadeUp {
  to { opacity: 1; transform: translateY(0); }
}

.hero-title {
  font-family: 'Orbitron', sans-serif;
  font-size: 64px;
  font-weight: 900;
  letter-spacing: 4px;
  line-height: 1.1;
  margin-bottom: 25px;
  text-transform: uppercase;
}

.hero-subtitle-big {
  font-size: 26px;
  font-weight: 500;
  max-width: 820px;
  margin: 0 auto;
  line-height: 1.5;
  color: rgba(255,255,255,0.88);
  text-shadow: 0 0 18px rgba(255, 107, 77, 0.35);
}

/* ═══════════════════════════════════
   CREW
═══════════════════════════════════ */

.crew {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(430px, 1fr));
  gap: 46px;
  padding: 70px 40px 120px;
  justify-items: center;
}

.crew-card {
  position: relative;
  width: 100%;
  max-width: 540px;
  padding: 42px 36px;
  border-radius: 34px;
  overflow: hidden;
  background:
    radial-gradient(circle at top, rgba(255, 120, 90, 0.16), rgba(5, 3, 8, 0.97) 60%),
    linear-gradient(180deg, rgba(24, 8, 12, 0.96), rgba(3, 2, 5, 0.98));
  border: 1px solid rgba(255, 120, 90, 0.2);
  box-shadow:
    0 0 45px rgba(255, 90, 60, 0.12),
    inset 0 0 60px rgba(255, 110, 80, 0.04);
  backdrop-filter: blur(16px);
  transition:
    transform 0.6s cubic-bezier(0.25, 0.1, 0.25, 1),
    box-shadow 0.6s cubic-bezier(0.25, 0.1, 0.25, 1),
    border-color 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.crew-card::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at top, rgba(255, 140, 100, 0.12), transparent 45%),
    linear-gradient(90deg, transparent, rgba(216, 194, 189, 0.07), transparent);
  pointer-events: none;
}

.crew-card::after {
  content: "";
  position: absolute;
  top: 0;
  right: -1px;
  width: 2px;
  height: 100%;
  background: linear-gradient(
    to bottom,
    rgba(255, 120, 90, 0),
    rgba(255, 120, 90, 1),
    rgba(255, 120, 90, 0)
  );
  box-shadow: 0 0 22px rgba(255, 120, 90, 0.9);
}

.crew-card:hover {
  transform: translateY(-12px) scale(1.015);
  border-color: rgba(255, 120, 90, 0.45);
  box-shadow:
    0 0 70px rgba(255, 110, 80, 0.18),
    0 0 140px rgba(255, 90, 60, 0.06),
    inset 0 0 70px rgba(255, 110, 80, 0.08);
}

.crew-photo {
  position: relative;
  width: 190px;
  height: 190px;
  margin: 0 auto 28px;
  border-radius: 50%;
  background-size: cover;
  background-position: center;
  border: 4px solid rgba(255, 180, 160, 0.14);
  box-shadow:
    0 0 45px rgba(255, 110, 80, 0.45),
    0 0 90px rgba(255, 110, 80, 0.14);
}

.crew-photo::before {
  content: "";
  position: absolute;
  inset: -14px;
  border-radius: 50%;
  border: 2px solid rgba(255, 140, 110, 0.4);
  box-shadow: 0 0 28px rgba(255, 110, 80, 0.55);
}

.crew-card h3 {
  margin: 0;
  text-align: center;
  font-size: 2rem;
  color: #fff;
  font-weight: 800;
}

.role {
  text-align: center;
  margin: 10px 0 28px;
  font-size: 1.1rem;
  color: #c9a39a;
}

.bio {
  text-align: center;
  line-height: 1.85;
  font-size: 1rem;
  color: rgba(255,255,255,0.74);
  margin-bottom: 34px;
}

.extra {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.extra p {
  margin: 0;
  display: flex;
  align-items: flex-start;
  gap: 14px;
  font-size: 1rem;
  line-height: 1.7;
  color: rgba(255,255,255,0.82);
  padding-bottom: 16px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}

.extra p:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.extra span {
  min-width: 95px;
  color: #ff9a7d;
  font-weight: 700;
}

/* ═══════════════════════════════════
   ФОТО
═══════════════════════════════════ */

.crew-card.alex .crew-photo {
  background-image: url("Capitan.png");
}

.crew-card.irina .crew-photo {
  background-image: url("Irina.png");
}

.crew-card.maxim .crew-photo {
  background-image: url("Maxim.png");
}

.crew-card.sofia .crew-photo {
  background-image: url("Sofia.png");
}

.crew-card.dmytro .crew-photo {
  background-image: url("Dmytro.png");
}

.crew-card.nik .crew-photo {
  background-image: url("Nikita.png");
}

/* ═══════════════════════════════════
   ANIMATION
═══════════════════════════════════ */

.reveal {
  opacity: 0;
  transform: translateY(70px);
  transition:
    opacity 1s ease,
    transform 1s ease;
}

.reveal.active {
  opacity: 1;
  transform: translateY(0);
}

/* ═══════════════════════════════════
   CREW INTRO BANNER
═══════════════════════════════════ */

.crew-intro {
  max-width: 1100px;
  margin: 0 auto;
  padding: 60px 40px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  flex-wrap: wrap;
}

.crew-intro-text {
  flex: 1;
  min-width: 260px;
}

.crew-intro-label {
  font-family: 'Orbitron', sans-serif;
  font-size: 0.65rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: #ff6b4d;
  margin-bottom: 12px;
  display: block;
}

.crew-intro-title {
  font-family: 'Orbitron', sans-serif;
  font-size: 1.6rem;
  font-weight: 900;
  color: #fff;
  margin: 0 0 14px;
  line-height: 1.25;
}

.crew-intro-desc {
  font-size: 0.95rem;
  color: rgba(223, 197, 190, 0.65);
  line-height: 1.75;
  margin: 0 0 22px;
}

.crew-intro-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 12px 26px;
  border: 1px solid rgba(255, 107, 77, 0.45);
  border-radius: 100px;
  background: rgba(255, 107, 77, 0.07);
  color: #ff9a7d;
  font-family: 'Montserrat', sans-serif;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.3s, border-color 0.3s, color 0.3s;
}

.crew-intro-btn:hover {
  background: rgba(255, 107, 77, 0.16);
  border-color: rgba(255, 107, 77, 0.7);
  color: #fff;
}

.crew-intro-stats {
  display: flex;
  gap: 28px;
  flex-wrap: wrap;
}

.crew-stat-pill {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px 24px;
  border-radius: 20px;
  border: 1px solid rgba(255, 120, 90, 0.18);
  background: radial-gradient(circle at top, rgba(255,120,90,0.09), rgba(5,3,8,0.95) 70%);
  min-width: 100px;
  transition: border-color 0.3s, box-shadow 0.3s;
}

.crew-stat-pill:hover {
  border-color: rgba(255, 107, 77, 0.4);
  box-shadow: 0 0 30px rgba(255, 107, 77, 0.1);
}

.crew-stat-num {
  font-family: 'Orbitron', sans-serif;
  font-size: 1.8rem;
  font-weight: 900;
  color: #ff6b4d;
  line-height: 1;
  text-shadow: 0 0 20px rgba(255,107,77,0.5);
}

.crew-stat-lbl {
  font-size: 0.68rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: rgba(223, 197, 190, 0.5);
  margin-top: 6px;
  font-weight: 700;
  text-align: center;
}

/* ═══════════════════════════════════
   MODAL
═══════════════════════════════════ */

.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(2, 1, 6, 0.88);
  backdrop-filter: blur(10px);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.35s ease;
}

.modal-overlay.open {
  opacity: 1;
  pointer-events: all;
}

.modal {
  position: relative;
  max-width: 680px;
  width: 100%;
  border-radius: 28px;
  padding: 48px 44px;
  background:
    radial-gradient(circle at top, rgba(255,120,90,0.14), rgba(5,3,8,0.98) 55%),
    linear-gradient(180deg, rgba(24,8,12,0.97), rgba(3,2,5,0.99));
  border: 1px solid rgba(255,120,90,0.25);
  box-shadow: 0 0 80px rgba(255,90,60,0.15), inset 0 0 60px rgba(255,110,80,0.04);
  transform: translateY(24px);
  transition: transform 0.35s ease;
}

.modal-overlay.open .modal {
  transform: translateY(0);
}

.modal-close {
  position: absolute;
  top: 20px;
  right: 22px;
  background: none;
  border: none;
  color: rgba(255,255,255,0.3);
  font-size: 1.4rem;
  cursor: pointer;
  transition: color 0.2s;
  line-height: 1;
}

.modal-close:hover { color: #ff6b4d; }

.modal-label {
  font-family: 'Orbitron', sans-serif;
  font-size: 0.62rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: #ff6b4d;
  margin-bottom: 14px;
  display: block;
}

.modal h2 {
  font-family: 'Orbitron', sans-serif;
  font-size: 1.45rem;
  font-weight: 900;
  color: #fff;
  margin: 0 0 16px;
  line-height: 1.3;
}

.modal-desc {
  font-size: 0.92rem;
  color: rgba(223, 197, 190, 0.65);
  line-height: 1.8;
  margin-bottom: 36px;
}

.modal-roles {
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1px solid rgba(255,120,90,0.15);
  border-radius: 16px;
  overflow: hidden;
}

.modal-role-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px;
  border-bottom: 1px solid rgba(255,255,255,0.05);
  transition: background 0.25s;
}

.modal-role-row:last-child { border-bottom: none; }
.modal-role-row:hover { background: rgba(255,107,77,0.05); }

.modal-role-name {
  font-size: 0.88rem;
  color: rgba(255,255,255,0.78);
  font-weight: 600;
}

.modal-role-bar-wrap {
  flex: 1;
  margin: 0 18px;
  height: 4px;
  background: rgba(255,255,255,0.06);
  border-radius: 10px;
  overflow: hidden;
}

.modal-role-bar {
  height: 100%;
  border-radius: 10px;
  background: linear-gradient(90deg, #ff6b4d, #ffb39a);
  box-shadow: 0 0 10px rgba(255,107,77,0.5);
  width: 0;
  transition: width 0.7s ease 0.1s;
}

.modal-overlay.open .modal-role-bar {
  width: var(--bar-w);
}

.modal-role-count {
  font-family: 'Orbitron', sans-serif;
  font-size: 0.85rem;
  color: #ff9a7d;
  font-weight: 700;
  min-width: 32px;
  text-align: right;
}

.modal-total {
  margin-top: 22px;
  padding-top: 18px;
  border-top: 1px solid rgba(255,107,77,0.15);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-total span:first-child {
  font-size: 0.78rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: rgba(223,197,190,0.4);
  font-weight: 700;
}

.modal-total span:last-child {
  font-family: 'Orbitron', sans-serif;
  font-size: 1.1rem;
  color: #ff6b4d;
  font-weight: 900;
  text-shadow: 0 0 16px rgba(255,107,77,0.5);
}

/* ═══════════════════════════════════
   SCROLLBAR
═══════════════════════════════════ */

::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: #060308;
}

::-webkit-scrollbar-thumb {
  background: linear-gradient(#ff6b4d, #ff9d85);
  border-radius: 20px;
}

/* ═══════════════════════════════════
   ADAPTIVE
═══════════════════════════════════ */

@media (max-width: 992px) {
  .hero-title {
    font-size: 56px;
  }

  .hero-subtitle-big {
    font-size: 22px;
  }

  .crew {
    grid-template-columns: 1fr;
    padding: 50px 24px 100px;
  }
}

@media (max-width: 768px) {
  .navbar {
    height: auto;
    padding: 12px 0;
  }

  .nav-container {
    flex-direction: column;
    gap: 16px;
  }

  .logo {
    top: 0;
  }

  .nav-menu {
    flex-wrap: wrap;
    justify-content: center;
  }

  .nav-menu a {
    margin: 8px 14px;
    font-size: 13px;
  }

  .hero {
    min-height: 680px;
  }

  .hero-title {
    font-size: 42px;
    letter-spacing: 2px;
  }

  .hero-subtitle-big {
    font-size: 18px;
  }

  .crew {
    grid-template-columns: 1fr;
    gap: 30px;
    padding: 40px 18px 90px;
  }

  .crew-card {
    padding: 30px 22px;
    border-radius: 26px;
  }

  .crew-photo {
    width: 145px;
    height: 145px;
  }

  .crew-card h3 {
    font-size: 1.6rem;
  }

  .bio {
    font-size: 0.95rem;
  }

  .extra p {
    flex-direction: column;
    gap: 4px;
  }
}
/* ═════════════════════════════════════════════════════
   FOOTER
   ═════════════════════════════════════════════════════ */

.footer-section {
  padding: 64px 0;
  border-top: 1px solid rgba(255, 107, 77, 0.18);
  background: linear-gradient(180deg, rgba(255, 107, 77, 0.04) 0%, transparent 40%);
}

.footer-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 52px;
  align-items: start;
}

.footer-left h2 {
  font-family: 'Orbitron', sans-serif;
  font-size: 1.7rem;
  font-weight: 900;
  margin: 0 0 16px;
  line-height: 1.2;
  background: linear-gradient(135deg, #fff1ea, #ffb39a, #ff6b4d);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.footer-left h2 span {
  background: linear-gradient(135deg, #ff6b4d, #ffb39a);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.footer-left p { font-size: 0.93rem; margin: 0 0 26px; }

.social-row { display: flex; gap: 10px; }

.social-btn {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  border: 1px solid rgba(223, 197, 190, 0.22);
  background: linear-gradient(135deg, rgba(255, 107, 77, 0.08), transparent);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.95rem;
  cursor: pointer;
  transition: 0.25s;
  color: #dfc5be;
}

.social-btn:hover {
  border-color: #ff6b4d;
  color: #ff6b4d;
  box-shadow: 0 0 14px rgba(255, 107, 77, 0.2);
}

#contact-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

#contact-form input,
#contact-form textarea {
  padding: 14px 16px;
  background: linear-gradient(145deg, rgba(255, 107, 77, 0.07), rgba(5, 3, 8, 0.96));
  border: 1px solid rgba(223, 197, 190, 0.18);
  border-radius: 12px;
  color: #dfc5be;
  font-size: 0.9rem;
  font-family: 'Montserrat', sans-serif;
  transition: 0.3s;
  outline: none;
}

#contact-form textarea {
  height: 110px;
  resize: none;
}

#contact-form input:focus,
#contact-form textarea:focus {
  border-color: #ff6b4d;
  box-shadow: 0 0 0 3px rgba(255, 107, 77, 0.12);
}

#contact-form input::placeholder,
#contact-form textarea::placeholder {
  color: rgba(223, 197, 190, 0.35);
}

#contact-form button {
  padding: 14px;
  background: linear-gradient(135deg, #ff6b4d, #ff9070);
  color: #1a0805;
  border: none;
  border-radius: 12px;
  font-weight: 900;
  font-size: 0.88rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  cursor: pointer;
  transition: 0.3s;
  box-shadow: 0 4px 18px rgba(255, 107, 77, 0.3);
  opacity: 0.6;
}

#contact-form button.ready,
#contact-form button:hover {
  box-shadow: 0 0 28px rgba(255, 107, 77, 0.6), 0 4px 22px rgba(255, 107, 77, 0.4);
  transform: translateY(-2px);
  opacity: 1;
}

.footer-copy {
  text-align: center;
  padding: 24px 0 0;
  font-size: 0.78rem;
  color: rgba(223, 197, 190, 0.3);
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  margin-top: 48px;
  letter-spacing: 0.06em;
}

/* ═════════════════════════════════════════════════════
   REVEAL
   ═════════════════════════════════════════════════════ */

.reveal {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.7s ease, transform 0.7s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}
